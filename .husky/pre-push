#!/usr/bin/env sh
# OSS-friendly pre-push gate: runs typecheck + hermetic test before allowing
# push. Travels with every fork (committed to repo). GitHub Actions is
# disabled at the databricks-solutions org level (see), so this
# hook is the only automated gate today; once Actions is enabled, the
# existing ci.yml provides the server-side equivalent.
#
# Escape hatch: HUSKY=0 git push   (skips this hook entirely)
# Use only when the gate is broken / not when the gate is correctly red.

set -e

echo "→ husky/pre-push: typecheck"
npm run typecheck

echo "→ husky/pre-push: test (hermetic)"
npm test

# The vendored apps/dashboard app is a SEPARATE package (own package.json + vitest + tsconfig); the
# root typecheck/test above never touch it, so a dashboard regression would otherwise push clean.
# ci.yml's dashboard job is the server-side equivalent, but Actions is disabled org-wide, so this
# hook is the only gate today. Skipped on a checkout without the app; deps are installed on first
# run (apps/dashboard has no committed lockfile, so `npm install`, matching build:dashboard).
if [ -d apps/dashboard ]; then
  echo "→ husky/pre-push: dashboard (typecheck + tests)"
  [ -d apps/dashboard/node_modules ] || ( cd apps/dashboard && npm install )
  ( cd apps/dashboard && npx tsc --noEmit && npx vitest run )
fi

echo "✓ husky/pre-push: pass"
